<script>
/* Galleria ad arco: scorre di continuo, si ferma con il mouse sopra */
(function () {
  var stage = document.querySelector('.arc-stage');
  if (!stage) return;
  var track = stage.querySelector('.arc-track');
  var base = [].slice.call(track.querySelectorAll('.arc-slot'));
  var n = base.length;
  if (n < 2) return;

  var SPEED = 0.2;               // card al secondo (0.2 = una card ogni 5 s)
  var slots = base.slice();
  var reps = Math.ceil(12 / n);  // duplicati per far sembrare il giro infinito
  for (var r = 1; r < reps; r++) {
    base.forEach(function (el) {
      var c = el.cloneNode(true);
      c.setAttribute('data-clone', '');
      c.setAttribute('aria-hidden', 'true');
      var link = c.querySelector('a');
      if (link) link.setAttribute('tabindex', '-1');
      track.appendChild(c);
      slots.push(c);
    });
  }
  var M = slots.length, half = M / 2;
  var t = 0, last = null, raf = null, hover = false, focus = false, anim = false;

  var mqDesk = window.matchMedia('(min-width:768px)');
  var mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  function render() {
    slots.forEach(function (el, k) {
      var x = k - (n - 1) / 2;
      var op = '';
      if (anim) {
        x = ((x - t + half) % M + M) % M - half;
        var a = Math.abs(x);
        if (a > half - 1) op = Math.max(0, half - a);
      }
      el.style.setProperty('--off', x.toFixed(3));
      el.style.setProperty('--abs', Math.abs(x).toFixed(3));
      el.style.opacity = op;
    });
  }

  function tick(now) {
    if (last === null) last = now;
    var dt = Math.min(now - last, 50) / 1000;
    last = now;
    if (!(hover || focus)) { t = (t + dt * SPEED) % M; render(); }
    raf = requestAnimationFrame(tick);
  }

  function apply() {
    var live = mqDesk.matches;
    anim = live && !mqReduce.matches;
    stage.classList.toggle('arc-live', live);
    stage.classList.toggle('arc-anim', anim);
    if (raf) { cancelAnimationFrame(raf); raf = null; }
    if (!live) { slots.forEach(function (el) { el.style.opacity = ''; }); return; }
    render();
    if (anim) { last = null; raf = requestAnimationFrame(tick); }
  }

  stage.addEventListener('mouseenter', function () { hover = true; });
  stage.addEventListener('mouseleave', function () { hover = false; last = null; });
  stage.addEventListener('focusin',  function () { focus = true; });
  stage.addEventListener('focusout', function () { focus = false; last = null; });
  mqDesk.addEventListener('change', apply);
  mqReduce.addEventListener('change', apply);
  apply();
})();
</script>

