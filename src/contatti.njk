    <script>
/* Galleria ad arco: scorre di continuo, si ferma con il mouse sopra e si può
   ruotare a comando trascinando con il dito (mobile) o con il mouse (desktop) */
(function () {
  var stage = document.querySelector('.arc-stage');
  if (!stage) return;
  var track = stage.querySelector('.arc-track');
  var base = [].slice.call(track.querySelectorAll('.arc-slot'));
  var n = base.length;
  if (n < 2) return;

  var SPEED = 0.2;               // card al secondo (0.2 = una card ogni 5 s)
  var slots = base.slice();
  var reps = Math.ceil(12 / n);  // duplicati per far sembrare il giro infinito
  for (var r = 1; r < reps; r++) {
    base.forEach(function (el) {
      var c = el.cloneNode(true);
      c.setAttribute('data-clone', '');
      c.setAttribute('aria-hidden', 'true');
      var link = c.querySelector('a');
      if (link) link.setAttribute('tabindex', '-1');
      track.appendChild(c);
      slots.push(c);
    });
  }
  var M = slots.length, half = M / 2;
  var t = 0, last = null, raf = null, hover = false, focus = false, dragging = false, anim = false;

  var mqReduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  function cardStepPx() {
    var w = window.innerWidth;
    var cardW = w >= 768
      ? Math.min(240, Math.max(170, w * 0.16))
      : Math.min(150, Math.max(110, w * 0.30));
    return cardW + 20; // + gap (1.25rem)
  }

  function render() {
    slots.forEach(function (el, k) {
      var x = k - (n - 1) / 2;
      var op = '';
      x = ((x - t + half) % M + M) % M - half;
      var a = Math.abs(x);
      if (a > half - 1) op = Math.max(0, half - a);
      el.style.setProperty('--off', x.toFixed(3));
      el.style.setProperty('--abs', a.toFixed(3));
      el.style.opacity = op;
    });
  }

  function tick(now) {
    if (last === null) last = now;
    var dt = Math.min(now - last, 50) / 1000;
    last = now;
    if (anim && !(hover || focus || dragging)) { t = (t + dt * SPEED) % M; render(); }
    raf = requestAnimationFrame(tick);
  }

  function apply() {
    anim = !mqReduce.matches;
    stage.classList.add('arc-live');
    stage.classList.toggle('arc-anim', anim);
    render();
    if (!raf) { last = null; raf = requestAnimationFrame(tick); }
  }

  stage.addEventListener('mouseenter', function () { hover = true; });
  stage.addEventListener('mouseleave', function () { hover = false; last = null; });
  stage.addEventListener('focusin',  function () { focus = true; });
  stage.addEventListener('focusout', function () { focus = false; last = null; });
  mqReduce.addEventListener('change', apply);

  /* Trascinamento: dito su mobile, mouse su desktop (Pointer Events unifica i due) */
  var drag = null;      // {x, y, t, active}
  var suppressClick = false;

  track.addEventListener('pointerdown', function (e) {
    if (e.pointerType === 'mouse' && e.button !== 0) return;
    drag = { x: e.clientX, y: e.clientY, t: t, active: false, id: e.pointerId };
  });

  track.addEventListener('pointermove', function (e) {
    if (!drag || drag.id !== e.pointerId) return;
    var dx = e.clientX - drag.x;
    var dy = e.clientY - drag.y;
    if (!drag.active) {
      if (Math.abs(dx) > 6 && Math.abs(dx) > Math.abs(dy)) {
        drag.active = true;
        dragging = true;
        stage.classList.add('is-dragging');
        try { track.setPointerCapture(e.pointerId); } catch (err) {}
      } else if (Math.abs(dy) > 6) {
        drag = null;
        return;
      } else {
        return;
      }
    }
    e.preventDefault();
    var deltaCards = dx / cardStepPx();
    t = ((drag.t - deltaCards) % M + M) % M;
    render();
  });

  function endDrag(e) {
    if (!drag) return;
    if (drag.active) {
      suppressClick = true;
      setTimeout(function () { suppressClick = false; }, 0);
    }
    drag = null;
    dragging = false;
    stage.classList.remove('is-dragging');
    last = null;
  }
  track.addEventListener('pointerup', endDrag);
  track.addEventListener('pointercancel', endDrag);

  stage.addEventListener('click', function (e) {
    if (suppressClick) { e.preventDefault(); e.stopPropagation(); }
  }, true);

  apply();
})();
</script>
    
