    <style>
  /* Fallback senza JS: fila orizzontale scorribile */
  .arc-track { display:flex; gap:1rem; overflow-x:auto; scroll-snap-type:x mandatory; padding:0 1.5rem 1.5rem; scrollbar-width:none; }
  .arc-slot { flex:0 0 68%; scroll-snap-align:center; }
  .arc-card { width:100%; aspect-ratio:3/4.3; }
  .arc-stage:not(.arc-live) .arc-card img { object-fit:contain; object-position:center; }
  .arc-stage:not(.arc-anim) .arc-slot[data-clone] { display:none; }

  /* Arco 3D (centro più piccolo, lati più grandi) — mobile e desktop.
     Le posizioni (--off = distanza dal centro in "card") le aggiorna lo script in fondo alla sezione. */
  .arc-stage { --w: clamp(110px, 30vw, 150px); }
  @media (min-width:768px) { .arc-stage { --w: clamp(170px, 16vw, 240px); } }
  .arc-live { cursor: grab; }
  .arc-live.is-dragging { cursor: grabbing; }
  .arc-live .arc-track {
    display:block; position:relative; overflow:visible; scroll-snap-type:none; padding:0;
    width:100%; height:calc(var(--w) * 4.3 / 3 + 7rem);
    perspective:1400px; transform-style:preserve-3d;
    touch-action: pan-y;
  }
  .arc-live .arc-slot {
    --off:0; --abs:0;
    position:absolute; top:3rem; left:50%; flex:none;
    width:var(--w); margin-left:calc(var(--w) / -2);
    transform-style:preserve-3d;
    transform: translateX(calc(var(--off) * (var(--w) + 1.25rem)))
               translateZ(calc(var(--abs) * 70px))
               rotateY(calc(var(--off) * -16deg));
  }
  .arc-live .arc-card {
    backface-visibility:hidden;
    filter: brightness(max(0.4, calc(1 - var(--abs) * 0.1)));
    transition: transform .5s cubic-bezier(.2,.8,.2,1);
    -webkit-user-select:none; user-select:none;
  }
  .arc-live.is-dragging .arc-card { transition:none; }
  /* Effetto hover: la card si raddrizza e si avvicina (mouse/tastiera) */
  .arc-live .arc-card:hover, .arc-live .arc-card:focus-visible {
    transform: rotateY(calc(var(--off) * 16deg)) translateZ(80px) scale(1.04);
    filter:none;
  }
</style>

