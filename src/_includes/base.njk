<!-- Script per il Menu Mobile -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const menuToggle = document.getElementById('menu-toggle');
    const menuClose = document.getElementById('menu-close');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = menuToggle.querySelector('.material-symbols-outlined');
    const menuItems = mobileMenu.querySelectorAll('nav > *');
    const body = document.body;

    // Stato iniziale delle voci (nascoste, pronte per l'animazione)
    menuItems.forEach(function(item) {
      item.style.opacity = '0';
      item.style.transform = 'translateY(12px)';
      item.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
    });

    function toggleMenu() {
      const isHidden = mobileMenu.classList.contains('menu-hidden');
      if (isHidden) {
        // Apri
        mobileMenu.classList.remove('menu-hidden');
        mobileMenu.classList.add('menu-visible');
        menuIcon.textContent = 'close';
        body.style.overflow = 'hidden';

        // Anima le voci in cascata
        menuItems.forEach(function(item, index) {
          setTimeout(function() {
            item.style.opacity = '1';
            item.style.transform = 'translateY(0)';
          }, 80 + index * 60);
        });
      } else {
        // Chiudi
        mobileMenu.classList.remove('menu-visible');
        mobileMenu.classList.add('menu-hidden');
        menuIcon.textContent = 'menu';
        body.style.overflow = '';

        // Reset per la prossima apertura
        menuItems.forEach(function(item) {
          item.style.opacity = '0';
          item.style.transform = 'translateY(12px)';
        });
      }
    }

    menuToggle.addEventListener('click', toggleMenu);
    menuClose.addEventListener('click', toggleMenu);

    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', toggleMenu);
    });
  });
</script>
