<style>
  /* Overlay menu mobile */
  #mobile-menu {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
    background: radial-gradient(circle at 50% 0%, rgba(56,189,248,0.08), transparent 60%),
                linear-gradient(180deg, #0a141b 0%, #070e14 100%);
  }
  .menu-hidden { transform: translateX(100%); opacity: 0; pointer-events: none; }
  .menu-visible { transform: translateX(0); opacity: 1; pointer-events: auto; }

  /* Reveal a cascata delle voci di menu */
  #mobile-menu nav a,
  #mobile-menu nav .menu-divider {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .menu-visible nav a:nth-child(1) { transition-delay: 0.08s; }
  .menu-visible nav a:nth-child(2) { transition-delay: 0.14s; }
  .menu-visible nav a:nth-child(3) { transition-delay: 0.20s; }
  .menu-visible nav a:nth-child(4) { transition-delay: 0.26s; }
  .menu-visible nav .menu-divider { transition-delay: 0.30s; }
  .menu-visible nav a:nth-child(6) { transition-delay: 0.34s; }
  .menu-visible nav a:nth-child(7) { transition-delay: 0.38s; }
  .menu-visible nav a,
  .menu-visible nav .menu-divider {
    opacity: 1;
    transform: translateY(0);
  }

  /* Sottolineatura animata al hover/focus sulle voci */
  #mobile-menu nav a.mobile-link {
    position: relative;
    display: inline-block;
  }
  #mobile-menu nav a.mobile-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 0;
    height: 2px;
    background: #38bdf8;
    transition: width 0.25s ease, left 0.25s ease;
  }
  #mobile-menu nav a.mobile-link:hover::after,
  #mobile-menu nav a.mobile-link.active-link::after {
    width: 40%;
    left: 30%;
  }

</style>
